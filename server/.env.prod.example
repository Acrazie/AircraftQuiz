# Production environment variable reference for Railway / Fly.io.
# Copy this to your platform's environment variable dashboard.
# NEVER commit real values — use platform secrets or .env.local (gitignored).

# ── Symfony core ─────────────────────────────────────────────────────────────
APP_ENV=prod
APP_SECRET=REPLACE_WITH_32_CHAR_RANDOM_STRING

# ── Database (Neon / Supabase / Railway Postgres) ─────────────────────────────
# Format: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://REPLACE_WITH_FULL_DSN

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate keypair locally:
#   php bin/console lexik:jwt:generate-keypair
# Then base64-encode each file:
#   base64 -i config/jwt/private.pem | tr -d '\n'
#   base64 -i config/jwt/public.pem  | tr -d '\n'
JWT_PRIVATE_KEY_B64=REPLACE_WITH_BASE64_ENCODED_PRIVATE_PEM
JWT_PUBLIC_KEY_B64=REPLACE_WITH_BASE64_ENCODED_PUBLIC_PEM
JWT_PASSPHRASE=REPLACE_WITH_JWT_PASSPHRASE

# ── CORS ──────────────────────────────────────────────────────────────────────
# Must match your Vercel deployment URL.
# Use a regex — e.g. for <project>.vercel.app plus a custom domain:
# CORS_ALLOW_ORIGIN='^https://(aircraftquiz\.vercel\.app|www\.yourdomain\.com)$'
CORS_ALLOW_ORIGIN=^https://REPLACE_WITH_VERCEL_APP_URL$

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID

# ── Symfony routing (used for CLI URL generation) ─────────────────────────────
DEFAULT_URI=https://REPLACE_WITH_RAILWAY_BACKEND_URL
