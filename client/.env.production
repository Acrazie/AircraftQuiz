# Production environment variables for Vercel.
# Set these in the Vercel dashboard (Settings → Environment Variables).
# This file only documents what is required — do NOT put real values here.

# Full URL of the production Symfony backend, including /api prefix.
# Example: https://aircraftquiz-backend.up.railway.app/api
VITE_API_URL=https://REPLACE_WITH_RAILWAY_BACKEND_URL/api

# Google OAuth client ID (same as dev unless you create a separate prod credential).
VITE_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
